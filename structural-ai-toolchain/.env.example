# Copy to .env for local development. In CI these are pipeline variables
# (GitHub Actions secrets now, GitLab CI/CD variables in production) —
# identical names on both platforms so migration is config-only.

# --- SharePoint / Microsoft Graph (client-credentials flow) ---
MSGRAPH_TENANT_ID=
MSGRAPH_CLIENT_ID=
MSGRAPH_CLIENT_SECRET=
SHAREPOINT_SITE_ID=
SHAREPOINT_DRIVE_ID=

# --- Graph change-notification webhooks ---
WEBHOOK_NOTIFICATION_URL=      # public HTTPS endpoint Graph calls
WEBHOOK_CLIENT_STATE=          # shared secret echoed by Graph

# --- Knowledge graph (future LLM embeddings) ---
KG_EMBEDDING_ENDPOINT=
KG_EMBEDDING_API_KEY=
