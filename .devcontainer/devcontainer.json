{
  // Opens the repository in GitHub Codespaces (or VS Code Dev Containers) with the
  // calculation knowledge base ready to run: Code > Codespaces > Create codespace.
  "name": "calculation-knowledge-base",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {}
  },
  "postCreateCommand": "pip install -r structural-ai-toolchain/requirements.txt && sudo apt-get update && sudo apt-get install -y --no-install-recommends chromium libreoffice-calc",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/structural-ai-toolchain",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {"label": "web calculator", "onAutoForward": "openPreview"}
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "redhat.vscode-yaml"]
    },
    "codespaces": {
      "openFiles": ["README.md"]
    }
  }
}
